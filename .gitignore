# --- captured media (large, not source) ---
# Detection clips and any pulled audio. The station keeps its own audio on the phone
# under an 8 GB cap; nothing binary from a capture belongs in git.
data/**/*.wav
data/**/*.flac
data/**/*.mp4
data/**/*.jpg

# --- models ---
# BirdNET's acoustic model (52 MB) and location/week meta-model (15 MB) are pushed to the
# device with adb, never bundled or committed. See recorder/station/README or DESIGN §11.
*.tflite

# --- android ---
recorder/.gradle/
recorder/build/
recorder/station/build/
recorder/local.properties
*.apk
*.keystore
!recorder/gradle/wrapper/gradle-wrapper.jar

# --- python ---
.venv*/
__pycache__/
*.pyc

# --- local agent settings (machine-specific paths; never publish) ---
.claude/settings.local.json

# --- os ---
Thumbs.db
desktop.ini
*.bak
