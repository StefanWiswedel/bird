<?xml version="1.0" encoding="utf-8"?>
<!--
  Biomon launcher foreground.

  The mark is a SPECTROGRAM READ AS A LEAF: eight rounded bars rising and falling in a
  leaf-shaped envelope, with a midrib through the middle. It says "sound" and "living
  thing" in one shape, which is what the app is, and it survives being 24 px in a status
  bar because it is bars — the one motif that stays legible when everything else turns to
  mush.

  Adaptive-icon geometry: the 108dp canvas keeps its outer 18dp as bleed, so all artwork
  sits inside the central 72dp (x,y from 18 to 90). Nothing important goes near the edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- midrib: the leaf's stem, doubling as the spectrogram's time axis -->
    <path
        android:fillColor="#66F8A2"
        android:pathData="M53,30 h2 a1,1 0 0 1 1,1 v46 a1,1 0 0 1 -1,1 h-2 a1,1 0 0 1 -1,-1 v-46 a1,1 0 0 1 1,-1 z" />

    <!-- bars, symmetric about the midrib, heights forming a leaf envelope -->
    <path android:fillColor="#95FBB2" android:pathData="M26,50 h4 a2,2 0 0 1 2,2 v4 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-4 a2,2 0 0 1 2,-2 z" />
    <path android:fillColor="#95FBB2" android:pathData="M33,44 h4 a2,2 0 0 1 2,2 v16 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-16 a2,2 0 0 1 2,-2 z" />
    <path android:fillColor="#7BDE96" android:pathData="M40,37 h4 a2,2 0 0 1 2,2 v30 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-30 a2,2 0 0 1 2,-2 z" />
    <path android:fillColor="#7BDE96" android:pathData="M47,32 h3 a2,2 0 0 1 2,2 v40 a2,2 0 0 1 -2,2 h-3 a2,2 0 0 1 -2,-2 v-40 a2,2 0 0 1 2,-2 z" />
    <path android:fillColor="#7BDE96" android:pathData="M58,32 h3 a2,2 0 0 1 2,2 v40 a2,2 0 0 1 -2,2 h-3 a2,2 0 0 1 -2,-2 v-40 a2,2 0 0 1 2,-2 z" />
    <path android:fillColor="#7BDE96" android:pathData="M64,37 h4 a2,2 0 0 1 2,2 v30 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-30 a2,2 0 0 1 2,-2 z" />
    <path android:fillColor="#95FBB2" android:pathData="M71,44 h4 a2,2 0 0 1 2,2 v16 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-16 a2,2 0 0 1 2,-2 z" />
    <path android:fillColor="#95FBB2" android:pathData="M78,50 h4 a2,2 0 0 1 2,2 v4 a2,2 0 0 1 -2,2 h-4 a2,2 0 0 1 -2,-2 v-4 a2,2 0 0 1 2,-2 z" />
</vector>
